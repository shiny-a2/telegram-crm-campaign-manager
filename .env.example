# ---------- یوزربات تلگرام (از my.telegram.org بگیر) ----------
TG_API_ID=
TG_API_HASH=
# شماره‌ی اکانت ارسال‌کننده با کد کشور، مثل +98912...
TG_PHONE=
TG_SESSION=data/outreach.session

# ---------- ضدبلاک: سقف و سرعت ----------
# سقف نهایی پیام در روز
DAILY_CAP=30
# گرم‌کردن: روز اول این تعداد، هر روز +WARMUP_STEP تا رسیدن به DAILY_CAP
WARMUP_START=15
WARMUP_STEP=5
# فاصله‌ی تصادفی بین دو ارسال (ثانیه)
DELAY_MIN_SEC=90
DELAY_MAX_SEC=210
# ساعت مجاز ارسال (به وقت تهران، ۲۴ساعته)
SEND_HOUR_START=10
SEND_HOUR_END=21
# وضعیت اولیه‌ی موتور ارسال: paused تا خودت از داشبورد روشن کنی
START_PAUSED=true

# ---------- داشبورد ----------
DASH_HOST=0.0.0.0
DASH_PORT=8091
# توکن ورود به داشبورد (در آدرس ?token=... یا فرم ورود)
DASH_TOKEN=
